pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: "${env.BRANCH_NAME}", url: 'https://github.com/2kita9/cicd-jenkins-pipeline-task.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Run App') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'main') {
                        sh 'echo Running MAIN branch on port 3000'
                    } else {
                        sh 'echo Running DEV branch on port 3001'
                    }
                }
            }
        }

    }
}
